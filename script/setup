#!/bin/sh

# Exit immediately if a command exits with a non-zero status.
set -e

echo "---> Iniciando setup do Discuza..."

# 1. Instalar dependências Ruby (Gems)
echo "---> Instalando gems..."
if gem list -i "^bundler$" > /dev/null; then
  echo "Bundler já instalado."
else
  gem install bundler
fi
bundle check || bundle install

# 2. Configurar Banco de Dados (Verificar PostgreSQL é manual)
echo "---> Configurando banco de dados..."
echo "*** Certifique-se que o PostgreSQL está instalado e rodando! ***"

# Verificar se database.yml existe, senão sair (deve existir pelo Git)
if [ ! -f config/database.yml ]; then
    echo "Erro: config/database.yml não encontrado. Verifique o repositório."
    exit 1
fi

# Criar banco de dados (ignora erro se já existir)
rails db:create 2>/dev/null || echo "Banco de dados já existe ou houve erro na criação (verificar manualmente)."

# Rodar migrações
echo "---> Rodando migrações..."
rails db:migrate

# 3. Configurar Variáveis de Ambiente
if [ -f .env.example ] && [ ! -f .env ]; then
  echo "---> Copiando .env.example para .env..."
  cp .env.example .env
  echo "*** Lembre-se de preencher o arquivo .env! ***"
elif [ -f .env ]; then
  echo "---> Arquivo .env já existe."
else
  echo "---> Arquivo .env.example não encontrado. Crie o .env manualmente se necessário."
fi

# 4. (Opcional) Seed Database
# Descomente a linha abaixo se quiser popular o banco automaticamente
# echo "---> Populando banco de dados (se seeds.rb existir)..."
# rails db:seed

echo "---> Setup básico concluído!"
echo "*** Importante: Se for a primeira vez, execute 'bin/rails credentials:edit' para gerar sua chave mestra local e configurar segredos de desenvolvimento. ***" 