<div class="max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14 mx-auto">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 mt-8">
    <% @categories.each do |category| %>
      <div class="block p-4 sm:p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md focus:shadow-md focus:outline-none focus:ring-2 focus:ring-lime-500 focus:ring-offset-2 transition-all duration-200 ease-in-out transform hover:-translate-y-1 dark:bg-neutral-900 dark:border-neutral-700 dark:hover:bg-neutral-800 dark:focus:ring-offset-neutral-900">
        <%= lucide_icon(category.icon, class: "size-7 mb-2 #{category.color_class || 'stroke-gray-800 dark:stroke-white'}") %>
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-1"><%= category.name %></h3>
      </div>
    <% end %>
    <% if @categories.none? %>
      <div class="col-span-full text-center text-gray-500 dark:text-neutral-400 py-10">Nenhuma categoria cadastrada ainda.</div>
    <% end %>
  </div>
</div>
