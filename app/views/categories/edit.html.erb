<% content_for :title, "Editar Categoria" %>

<div class="max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14 mx-auto mt-8">
  <div>
    <%# Wrapper para título e botão %>
    <div class="flex items-center justify-between mb-4">
      <h1 class="font-bold text-4xl">Editar Categoria</h1>
      <%# Botão movido para cá, associado ao form pelo ID %>
      <%= button_tag "Atualizar Categoria", type: :submit, form: "edit_category_form", class: "btn btn-primary inline-flex justify-center items-center gap-x-2" %>
    </div>

    <%# Adiciona ID ao form para associação com o botão %>
    <%= render "form", category: @category, form_id: "edit_category_form" %>

    <%# Link para voltar %>
    <div class="mt-4">
      <%= link_to "← Voltar", categories_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-neutral-400 dark:hover:text-neutral-200 transition-colors" %>
    </div>
  </div>
</div>
