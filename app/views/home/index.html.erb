<div class="w-full px-3 pb-10 sm:px-4 lg:px-8 lg:pb-14 mx-auto lg:max-w-7xl">
  <%# Seção de Categorias %>
  <div class="mb-8">
    <div class="flex justify-between items-center mb-2 mt-8">
      <h2 class="text-2xl font-semibold font-geist text-gray-800 dark:text-white">Navegar por Categoria</h2>
      <%= link_to "Ver todas (#{@categories.count})", categories_path, class: "text-sm font-medium transition-colors", style: "color: var(--color-primary-dark);" %>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      <%# Loop pelas top 4 categorias com mais posts, ou as 4 primeiras se nenhuma tiver posts %>
      <% @categories.left_joins(:discussions).group('categories.id').order('COUNT(discussions.id) DESC, categories.created_at ASC').limit(4).each do |category| %>
        <%= link_to category_path(category), class: "block p-4 sm:p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md focus:shadow-md focus:outline-none focus:ring-2 focus:ring-lime-500 focus:ring-offset-2 transition-all duration-200 ease-in-out transform hover:-translate-y-1 dark:bg-neutral-800 dark:border-neutral-600 dark:hover:bg-neutral-700 dark:focus:ring-offset-neutral-800" do %>
          <%= lucide_icon(category.icon, class: "size-6 mb-2 #{category.color_class || 'stroke-gray-800 dark:stroke-white'}") %>
          <h3 class="text-lg font-semibold font-geist text-gray-800 dark:text-white"><%= category.name %></h3>
          <div class="mb-1">
            <%# Badge colorido com cor de fundo clara baseada em color_class %>
            <% bg_class = case category.color_class
              when /lime/ then 'bg-lime-100 text-lime-800 dark:bg-lime-500/10 dark:text-lime-500'
              when /blue/ then 'bg-blue-100 text-blue-800 dark:bg-blue-500/10 dark:text-blue-500'
              when /red/ then 'bg-red-100 text-red-800 dark:bg-red-500/10 dark:text-red-500'
              when /purple/ then 'bg-purple-100 text-purple-800 dark:bg-purple-500/10 dark:text-purple-500'
              when /yellow/ then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-500/10 dark:text-yellow-500'
              when /teal/ then 'bg-teal-100 text-teal-800 dark:bg-teal-500/10 dark:text-teal-500'
              when /pink/ then 'bg-pink-100 text-pink-800 dark:bg-pink-500/10 dark:text-pink-500'
              when /indigo/ then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/10 dark:text-indigo-500'
              when /green/ then 'bg-green-100 text-green-800 dark:bg-green-500/10 dark:text-green-500'
              else 'bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-300'
            end %>
            <span class="inline-flex items-center gap-x-1.5 px-2 py-0.5 rounded-full text-xs font-medium <%= bg_class %>">
              <span class="font-semibold"><%= category.discussions.count %></span> <span>post<%= 's' if category.discussions.count != 1 %></span>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <%# Fim Seção de Categorias %>

  <!-- Search Results Header -->
  <% if @search_term.present? %>
    <div class="mb-6 p-4 bg-lime-50 border border-lime-200 rounded-lg dark:bg-lime-500/10 dark:border-lime-500/20">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-x-3">
          <%= lucide_icon('search', class: "size-5 text-lime-600 dark:text-lime-500") %>
          <div>
            <h3 class="text-lg font-semibold text-lime-800 dark:text-lime-400">
              Resultados da busca
            </h3>
            <p class="text-sm text-lime-700 dark:text-lime-300">
              <% if @discussions.any? %>
                Encontrado<%= 's' if @discussions.count != 1 %> <strong><%= @discussions.count %></strong> discussão<%= 'ões' if @discussions.count != 1 %> para "<strong><%= @search_term %></strong>"
              <% else %>
                Nenhuma discussão encontrada para "<strong><%= @search_term %></strong>"
              <% end %>
            </p>
          </div>
        </div>
        <%= link_to root_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-lime-600 hover:text-lime-700 dark:text-lime-500 dark:hover:text-lime-400" do %>
          <%= lucide_icon('x', class: "size-4") %>
          Limpar busca
        <% end %>
      </div>
    </div>
  <% end %>
  <!-- End Search Results Header -->

  <div class="flex justify-between items-center mb-2">
    <h1 class="text-3xl font-bold font-geist text-black dark:text-white">
      <% if @search_term.present? %>
        Resultados da Busca
      <% else %>
        Discussões Recentes
      <% end %>
    </h1>
    <%# Botão Filtros %>
    <div>
      <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm opacity-60 cursor-not-allowed dark:bg-neutral-800 dark:border-neutral-600 dark:text-white">
        <%= lucide_icon('sliders-horizontal', class: "flex-shrink-0 size-4") %>
        Filtros
        <%# Badge "Em breve" %>
        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-500/10 dark:text-amber-500">
          Em breve
        </span>
      </button>
    </div>
  </div>

  <div class="flex flex-col lg:grid lg:grid-cols-3 gap-4 lg:gap-8">
    <%# Coluna Principal %>
    <div class="w-full lg:col-span-2">
      <div class="space-y-4 sm:space-y-6">
        <%# Itera sobre as discussões reais %>
        <% @discussions.each do |discussion| %>
          <%# Card de Discussão Redesenhado %>
          <div class="w-full p-3 sm:p-4 md:p-5 rounded-lg border border-gray-200 bg-white shadow-sm dark:bg-neutral-800 dark:border-neutral-600">
            <%# Mobile Layout %>
            <div class="md:hidden">
              <%# Título %>
              <div class="mb-3">
                <h2 class="text-lg font-semibold text-black dark:text-white">
                  <%= link_to discussion.title, discussion_path(discussion), class: "hover:text-lime-600 dark:hover:text-lime-500 transition-colors" %>
                </h2>
              </div>
              
              <%# Badge e Timestamp acima do conteúdo no mobile %>
              <div class="flex items-center justify-between mb-3">
                <%# Badge da Categoria %>
                <% bg_class = case discussion.category.color_class
                  when /lime/ then 'bg-lime-100 text-lime-800 dark:bg-lime-500/10 dark:text-lime-500'
                  when /blue/ then 'bg-blue-100 text-blue-800 dark:bg-blue-500/10 dark:text-blue-500'
                  when /red/ then 'bg-red-100 text-red-800 dark:bg-red-500/10 dark:text-red-500'
                  when /purple/ then 'bg-purple-100 text-purple-800 dark:bg-purple-500/10 dark:text-purple-500'
                  when /yellow/ then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-500/10 dark:text-yellow-500'
                  when /teal/ then 'bg-teal-100 text-teal-800 dark:bg-teal-500/10 dark:text-teal-500'
                  when /pink/ then 'bg-pink-100 text-pink-800 dark:bg-pink-500/10 dark:text-pink-500'
                  when /indigo/ then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/10 dark:text-indigo-500'
                  when /green/ then 'bg-green-100 text-green-800 dark:bg-green-500/10 dark:text-green-500'
                  else 'bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-300'
                end %>
                <span class="inline-flex items-center gap-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium <%= bg_class %>">
                  <%= lucide_icon(discussion.category.icon, class: "flex-shrink-0 size-3") %>
                  <%= discussion.category.name %>
                </span>
                
                <%# Timestamp e Pin %>
                <div class="flex items-center gap-x-2">
                  <span class="text-xs text-gray-500 dark:text-neutral-500" title="<%= discussion.created_at.strftime('%d %b %Y, %H:%M') %>">
                    <%= time_ago_in_words(discussion.created_at) %> atrás
                  </span>
                  <% if current_user&.is_admin? %>
                    <%= button_to toggle_pin_discussion_path(discussion), method: :patch, class: 'ml-1', form: { data: { turbo: false } }, title: (discussion.pinned? ? 'Unpin discussion' : 'Pin discussion') do %>
                      <%= lucide_icon(discussion.pinned? ? 'pin' : 'pin', class: "size-4 #{discussion.pinned? ? 'text-lime-600 fill-lime-600' : 'text-gray-400'}") %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Desktop Layout %>
            <div class="hidden md:block">
              <%# Header com Título e Badge %>
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <%# Título e Badge na mesma linha %>
                  <div class="flex items-baseline gap-x-3 mb-2">
                    <h2 class="text-lg font-semibold text-black dark:text-white">
                      <%= link_to discussion.title, discussion_path(discussion), class: "hover:text-lime-600 dark:hover:text-lime-500 transition-colors" %>
                    </h2>
                    <%# Badge da Categoria %>
                    <% bg_class = case discussion.category.color_class
                      when /lime/ then 'bg-lime-100 text-lime-800 dark:bg-lime-500/10 dark:text-lime-500'
                      when /blue/ then 'bg-blue-100 text-blue-800 dark:bg-blue-500/10 dark:text-blue-500'
                      when /red/ then 'bg-red-100 text-red-800 dark:bg-red-500/10 dark:text-red-500'
                      when /purple/ then 'bg-purple-100 text-purple-800 dark:bg-purple-500/10 dark:text-purple-500'
                      when /yellow/ then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-500/10 dark:text-yellow-500'
                      when /teal/ then 'bg-teal-100 text-teal-800 dark:bg-teal-500/10 dark:text-teal-500'
                      when /pink/ then 'bg-pink-100 text-pink-800 dark:bg-pink-500/10 dark:text-pink-500'
                      when /indigo/ then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/10 dark:text-indigo-500'
                      when /green/ then 'bg-green-100 text-green-800 dark:bg-green-500/10 dark:text-green-500'
                      else 'bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-300'
                    end %>
                    <span class="inline-flex items-center gap-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium <%= bg_class %>">
                      <%= lucide_icon(discussion.category.icon, class: "flex-shrink-0 size-3") %>
                      <%= discussion.category.name %>
                    </span>
                  </div>
                </div>
                <%# Timestamp e Pin (se admin) %>
                <div class="flex items-center gap-x-2">
                  <span class="text-xs text-gray-500 dark:text-neutral-500" title="<%= discussion.created_at.strftime('%d %b %Y, %H:%M') %>">
                    <%= time_ago_in_words(discussion.created_at) %> atrás
                  </span>
                  <% if current_user&.is_admin? %>
                    <%= button_to toggle_pin_discussion_path(discussion), method: :patch, class: 'ml-1', form: { data: { turbo: false } }, title: (discussion.pinned? ? 'Unpin discussion' : 'Pin discussion') do %>
                      <%= lucide_icon(discussion.pinned? ? 'pin' : 'pin', class: "size-4 #{discussion.pinned? ? 'text-lime-600 fill-lime-600' : 'text-gray-400'}") %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Conteúdo/Snippet (Truncado) %>
            <div class="text-gray-700 dark:text-neutral-300 mb-4 text-sm prose prose-sm dark:prose-invert max-w-none">
              <%= action_text_snippet(discussion.content, length: 200) %> <%# Usa helper para truncar %>
            </div>

            <%# Tags (Removido por enquanto - usar dados reais depois) %>
            <%# <div class="flex flex-wrap gap-2 mb-4"> ... </div> %>

            <%# Footer %>
            <div class="flex items-center justify-between text-sm text-gray-600 dark:text-neutral-400">
              <div class="flex items-center gap-x-4">
                <%# Votação: Up/Down + contagem %>
                <%= render partial: 'discussions/votes', locals: { discussion: discussion } %>
                <%# Replies %>
                <span class="inline-flex items-center gap-x-1.5">
                  <%= lucide_icon('message-circle', class: "flex-shrink-0 size-4") %>
                  <%= discussion.replies.count %> <%# Contagem real de respostas %>
                </span>
                <%# Favorito %>
                <% if user_signed_in? %>
                  <% if current_user.favorited_discussions.include?(discussion) %>
                    <%= button_to unfavorite_discussion_path(discussion), method: :delete, 
                                  class: "inline-flex items-center gap-x-1.5 text-yellow-600 dark:text-yellow-400 hover:text-yellow-700 dark:hover:text-yellow-300 transition-colors text-xs",
                                  form_class: "inline-flex",
                                  title: "Desfavoritar" do %>
                      <%= lucide_icon('bookmark-check', class: "flex-shrink-0 size-4") %>
                      <span>Favoritado</span>
                    <% end %>
                  <% else %>
                    <%= button_to favorite_discussion_path(discussion), method: :post, 
                                  class: "inline-flex items-center gap-x-1.5 text-gray-400 hover:text-yellow-600 dark:text-neutral-500 dark:hover:text-yellow-400 transition-colors text-xs",
                                  form_class: "inline-flex",
                                  title: "Favoritar" do %>
                      <%= lucide_icon('bookmark', class: "flex-shrink-0 size-4") %>
                      <span>Favoritar</span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
              <%# Autor no canto direito %>
              <div class="flex items-center gap-x-2">
                <%# Avatar/Iniciais do Autor %>
                <% if discussion.user.avatar.attached? %>
                  <img class="inline-block size-6 rounded-full object-cover" src="<%= url_for(discussion.user.avatar) %>" alt="<%= discussion.user.name %> avatar">
                <% else %>
                  <div class="inline-flex items-center justify-center size-6 rounded-full bg-gray-500 text-white text-xs font-semibold">
                    <%= user_initials(discussion.user) %>
                  </div>
                <% end %>
                <span class="font-medium text-xs text-gray-700 dark:text-neutral-300"><%= discussion.user.name %></span>
              </div>
            </div>
          </div>
          <%# Fim Card Redesenhado %>
        <% end %>

        <%# Paginação %>
        <% if @discussions.respond_to?(:current_page) && @discussions.total_pages > 1 %>
          <nav class="mt-8 w-full" aria-label="Pagination">
            <div class="flex items-center justify-center">
              <div class="flex items-center space-x-0.5 sm:space-x-1">
                <%# Botão Anterior %>
                <% if @discussions.prev_page %>
                  <%= link_to root_path(page: @discussions.prev_page), 
                      class: "inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-50 hover:text-gray-900 dark:bg-neutral-800 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-700 dark:hover:text-white transition-colors" do %>
                    <%= lucide_icon('chevron-left', class: "size-3 sm:size-4 sm:mr-1") %>
                    <span class="hidden sm:inline">Anterior</span>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-l-lg cursor-not-allowed dark:bg-neutral-700 dark:border-neutral-600 dark:text-neutral-500">
                    <%= lucide_icon('chevron-left', class: "size-3 sm:size-4 sm:mr-1") %>
                    <span class="hidden sm:inline">Anterior</span>
                  </span>
                <% end %>

                <%# Páginas - Limitadas no mobile %>
                <% 
                  total_pages = @discussions.total_pages
                  current_page = @discussions.current_page
                  
                  # Mobile: mostra apenas 3 páginas ao redor da atual
                  # Desktop: mostra todas (se <= 7) ou janela de 5 páginas
                  if total_pages <= 7
                    pages_to_show = (1..total_pages).to_a
                  else
                    # Mobile logic
                    start_page = [current_page - 1, 1].max
                    end_page = [start_page + 2, total_pages].min
                    start_page = [end_page - 2, 1].max
                    pages_to_show = (start_page..end_page).to_a
                  end
                %>
                
                <% pages_to_show.each do |page| %>
                  <% if page == current_page %>
                    <span class="inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-white border" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                      <%= page %>
                    </span>
                  <% else %>
                    <%= link_to root_path(page: page), 
                        class: "inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:bg-neutral-800 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-700 dark:hover:text-white transition-colors" do %>
                      <%= page %>
                    <% end %>
                  <% end %>
                <% end %>

                <%# Indicador de mais páginas no mobile %>
                <% if total_pages > 7 && current_page < total_pages - 1 %>
                  <span class="sm:hidden inline-flex items-center px-2 py-2 text-xs font-medium text-gray-400">
                    ...
                  </span>
                <% end %>

                <%# Botão Próximo %>
                <% if @discussions.next_page %>
                  <%= link_to root_path(page: @discussions.next_page), 
                      class: "inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-50 hover:text-gray-900 dark:bg-neutral-800 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-700 dark:hover:text-white transition-colors" do %>
                    <span class="hidden sm:inline">Próximo</span>
                    <%= lucide_icon('chevron-right', class: "size-3 sm:size-4 sm:ml-1") %>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center px-2 sm:px-3 py-2 text-xs sm:text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-r-lg cursor-not-allowed dark:bg-neutral-700 dark:border-neutral-600 dark:text-neutral-500">
                    <span class="hidden sm:inline">Próximo</span>
                    <%= lucide_icon('chevron-right', class: "size-3 sm:size-4 sm:ml-1") %>
                  </span>
                <% end %>
              </div>
            </div>
          </nav>

          <%# Informações da Paginação %>
          <div class="mt-4 text-center text-xs sm:text-sm text-gray-600 dark:text-neutral-400 px-2">
            <% 
              start_num = (@discussions.current_page - 1) * 10 + 1
              end_num = [@discussions.current_page * 10, @discussions.total_count].min
            %>
            <span class="hidden sm:inline">Exibindo <%= start_num %> - <%= end_num %> de <%= @discussions.total_count %> discussões</span>
            <span class="sm:hidden">Página <%= @discussions.current_page %> de <%= @discussions.total_pages %></span>
          </div>
        <% end %>

        <%# Mensagem se não houver discussões %>
        <% if @discussions.none? %>
          <p class="text-center text-gray-500 dark:text-neutral-400 py-10">Nenhuma discussão encontrada ainda.</p>
        <% end %>
      </div>
    </div>
    <%# Fim Coluna Principal %>

    <%# Coluna Lateral (Aside) - Mantida com Mock Data por enquanto %>
    <aside class="w-full lg:col-span-1 space-y-6">
      <%# Card Recomendadas %>
      <div class="w-full rounded-lg border border-gray-200 bg-white shadow-sm dark:bg-neutral-800 dark:border-neutral-600">
        <div class="py-3 px-4 border-b dark:border-neutral-600">
          <h2 class="text-xl font-semibold font-geist text-black dark:text-white">Recomendadas</h2>
        </div>
        <div class="p-4">
          <ul class="space-y-3">
            <%# Loop pelas discussões recomendadas do banco de dados %>
            <% @recommended_discussions.each do |rec| %>
              <li>
                <div class="space-y-1">
                  <%= link_to rec.title, discussion_path(rec), class: "block text-sm text-gray-700 hover:text-lime-600 dark:text-neutral-300 dark:hover:text-lime-500 font-geist leading-tight" %>
                  <span class="text-xs text-gray-500 dark:text-neutral-500" title="<%= rec.created_at.strftime('%d %b %Y, %H:%M') %>">
                    <%= time_ago_in_words(rec.created_at) %> atrás
                  </span>
                </div>
              </li>
            <% end %>
            <% if @recommended_discussions.none? %>
              <li>
                <p class="text-sm text-gray-500 dark:text-neutral-400">Nenhuma discussão recomendada por enquanto.</p>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# Card Tags Populares %>
      <div class="w-full rounded-lg border border-gray-200 bg-white shadow-sm dark:bg-neutral-800 dark:border-neutral-600">
         <div class="py-3 px-4 border-b dark:border-neutral-600">
           <h2 class="text-xl font-semibold font-geist text-black dark:text-white">Tags Populares</h2>
         </div>
         <div class="p-4">
           <div class="flex flex-wrap gap-2">
             <% @categories.each do |category| %>
               <%# Badge colorido com cor de fundo clara baseada em color_class %>
               <% bg_class = case category.color_class
                 when /lime/ then 'bg-lime-100 text-lime-800 dark:bg-lime-500/10 dark:text-lime-500'
                 when /blue/ then 'bg-blue-100 text-blue-800 dark:bg-blue-500/10 dark:text-blue-500'
                 when /red/ then 'bg-red-100 text-red-800 dark:bg-red-500/10 dark:text-red-500'
                 when /purple/ then 'bg-purple-100 text-purple-800 dark:bg-purple-500/10 dark:text-purple-500'
                 when /yellow/ then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-500/10 dark:text-yellow-500'
                 when /teal/ then 'bg-teal-100 text-teal-800 dark:bg-teal-500/10 dark:text-teal-500'
                 when /pink/ then 'bg-pink-100 text-pink-800 dark:bg-pink-500/10 dark:text-pink-500'
                 when /indigo/ then 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/10 dark:text-indigo-500'
                 when /green/ then 'bg-green-100 text-green-800 dark:bg-green-500/10 dark:text-green-500'
                 else 'bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-300'
               end %>
               <span class="py-1 px-2.5 inline-flex items-center gap-x-1.5 text-xs font-medium rounded-full <%= bg_class %>">
                 <%= category.name %>
                 <span class="py-0.5 px-1.5 rounded-full text-xs font-medium bg-white text-gray-600 dark:bg-neutral-700 dark:text-neutral-300"><%= category.discussions.count %></span>
               </span>
             <% end %>
           </div>
         </div>
      </div>

      <%# Card: Discussões Mais Votadas %>
      <div class="w-full rounded-lg border border-gray-200 bg-white shadow-sm dark:bg-neutral-800 dark:border-neutral-600">
        <div class="py-3 px-4 border-b dark:border-neutral-600">
          <h2 class="text-xl font-semibold font-geist text-black dark:text-white">Mais Votadas 🔥</h2>
        </div>
        <div class="p-4">
          <ul class="space-y-4">
            <%# Mock Data - Discussões Mais Votadas com Avatares %>
            <% @top_discussions.each_with_index do |discussion, index| %>
              <li>
                <a href="<%= discussion_path(discussion) %>" class="group flex items-start gap-x-3 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-neutral-700 transition-colors duration-150">
                  <div class="text-lg font-semibold text-gray-400 dark:text-neutral-500 group-hover:text-lime-600 dark:group-hover:text-lime-500 w-6 text-center"><%= index + 1 %>º</div>
                  <div class="flex-1">
                    <span class="block text-sm font-medium text-gray-800 dark:text-neutral-200 group-hover:text-lime-700 dark:group-hover:text-lime-400 truncate">
                      <%= truncate(discussion.title, length: 40) %>
                      <%# Badge Hot para o primeiro item %>
                      <% if index == 0 %>
                        <span class="ms-2 inline-flex items-center gap-x-1 py-0.5 px-1.5 rounded-full text-xs font-medium bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-500">
                          <%= lucide_icon('flame', class: "flex-shrink-0 size-3") %>
                          Hot
                        </span>
                      <%# Badge Popular para o segundo item %>
                      <% elsif index == 1 %>
                        <span class="ms-2 inline-flex items-center gap-x-1 py-0.5 px-1.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-500/10 dark:text-blue-500">
                          Popular
                        </span>
                      <% end %>
                    </span>
                    <span class="block text-xs text-gray-500 dark:text-neutral-500 mb-1"><%= discussion.upvotes_count %> votos</span>
                    <%# Avatares Empilhados dos usuários que deram upvote %>
                    <div class="flex -space-x-2 rtl:space-x-reverse">
                      <% discussion.votes.select { |v| v.value == 1 }.first(5).each do |vote| %>
                        <% if vote.user&.avatar&.attached? %>
                          <img class="inline-block size-6 rounded-full ring-2 ring-white dark:ring-neutral-900" src="<%= url_for(vote.user.avatar) %>" alt="Voter avatar">
                        <% else %>
                          <div class="inline-flex items-center justify-center size-6 rounded-full bg-gray-500 text-white text-xs font-semibold ring-2 ring-white dark:ring-neutral-900">
                            <%= user_initials(vote.user) %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <%# Fim Card: Discussões Mais Votadas %>

      <%# Card: Usuários Mais Ativos %>
      <div class="w-full rounded-lg border border-gray-200 bg-white shadow-sm dark:bg-neutral-800 dark:border-neutral-600">
        <div class="py-3 px-4 border-b dark:border-neutral-600">
          <h2 class="text-xl font-semibold font-geist text-black dark:text-white">Usuários Mais Ativos 👥</h2>
        </div>
        <div class="p-4">
          <ul class="space-y-4">
            <%# Busca usuários mais ativos com base em discussões + respostas %>
            <% 
              # Query para encontrar usuários mais ativos
              active_users = User.joins("LEFT JOIN discussions ON discussions.user_id = users.id")
                                .joins("LEFT JOIN replies ON replies.user_id = users.id")
                                .group("users.id")
                                .select("users.*, 
                                        COUNT(DISTINCT discussions.id) as discussions_count,
                                        COUNT(DISTINCT replies.id) as replies_count,
                                        (COUNT(DISTINCT discussions.id) + COUNT(DISTINCT replies.id)) as total_activity")
                                .order("total_activity DESC")
                                .limit(5)
            %>
            <% active_users.each_with_index do |user, index| %>
              <li>
                <div class="group flex items-center gap-x-3 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-neutral-700 transition-colors duration-150">
                  <div class="text-lg font-semibold text-gray-400 dark:text-neutral-500 group-hover:text-lime-600 dark:group-hover:text-lime-500 w-6 text-center"><%= index + 1 %>º</div>
                  <%# Avatar do usuário %>
                  <div class="flex-shrink-0">
                    <% if user.avatar.attached? %>
                      <img class="inline-block size-10 rounded-full object-cover ring-2 ring-gray-200 dark:ring-neutral-700" src="<%= url_for(user.avatar) %>" alt="<%= user.name %> avatar">
                    <% else %>
                      <div class="inline-flex items-center justify-center size-10 rounded-full text-white text-sm font-semibold ring-2 ring-gray-200 dark:ring-neutral-700" style="background-color: var(--color-primary);">
                        <%= user_initials(user) %>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-x-2">
                      <span class="block text-sm font-medium text-gray-800 dark:text-neutral-200 truncate">
                        <%= user.name %>
                        <%# Badge MVP para o primeiro colocado %>
                        <% if index == 0 %>
                          <span class="ms-2 inline-flex items-center gap-x-1 py-0.5 px-1.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700 dark:bg-yellow-500/10 dark:text-yellow-500">
                            <%= lucide_icon('crown', class: "flex-shrink-0 size-3") %>
                            MVP
                          </span>
                        <% end %>
                      </span>
                    </div>
                    <div class="flex items-center gap-x-4 text-xs text-gray-500 dark:text-neutral-500">
                      <span class="flex items-center gap-x-1">
                        <%= lucide_icon('message-square', class: "flex-shrink-0 size-3") %>
                        <%= user.discussions_count %> discussões
                      </span>
                      <span class="flex items-center gap-x-1">
                        <%= lucide_icon('reply', class: "flex-shrink-0 size-3") %>
                        <%= user.replies_count %> respostas
                      </span>
                    </div>
                    <%# Barra de atividade visual %>
                    <div class="mt-1">
                      <% 
                        # Calcula porcentagem baseada no usuário mais ativo
                        max_activity = active_users.first.total_activity.to_f
                        activity_percentage = max_activity > 0 ? (user.total_activity.to_f / max_activity * 100).round : 0
                      %>
                      <div class="w-full bg-gray-200 rounded-full h-1.5 dark:bg-neutral-700">
                        <div class="h-1.5 rounded-full transition-all duration-300" style="width: <%= activity_percentage %>%; background-color: var(--color-primary);"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
            <%# Mensagem se não houver usuários ativos %>
            <% if active_users.none? %>
              <li>
                <p class="text-sm text-gray-500 dark:text-neutral-400 text-center py-4">Nenhum usuário ativo por enquanto.</p>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <%# Fim Card: Usuários Mais Ativos %>

    </aside>
    <%# Fim Coluna Lateral %>
  </div>
</div>
