<!DOCTYPE html>
<html class="h-full">
  <head>
    <title>Integração - Discuza</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Geist', sans-serif; }
      :root {
        --color-primary: <%= @system_config.primary_color_variables[:primary] %>;
        --color-primary-dark: <%= @system_config.primary_color_variables[:primary_dark] %>;
        --color-primary-light: <%= @system_config.primary_color_variables[:primary_light] %>;
      }
    </style>
  </head>
  <body class="bg-gray-900 min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <main class="max-w-3xl mx-auto w-full">
      <div class="rounded-xl shadow-2xl border" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%); border-color: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
        <div class="p-6 sm:p-8">
          <div class="mb-6 w-full flex justify-center">
            <%= image_tag 'logo_dark.svg', alt: "Discuza Logo", class: "h-12 w-auto" %>
          </div>
          <h2 class="text-2xl font-bold text-center text-white mb-6">Bem-vindo ao Discuza</h2>
          <p class="mb-6 text-center text-gray-300">Vamos configurar sua conta de administrador e o sistema.</p>

          <% if @user.errors.any? || @system_config.errors.any? %>
            <div class="mb-4 w-full space-y-2">
              <% (@user.errors.full_messages + @system_config.errors.full_messages).each do |msg| %>
                <div class="px-4 py-3 rounded-md border text-sm" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3); color: #fecaca;" role="alert">
                  <%= msg %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= form_with url: onboarding_path, method: :post, local: true, multipart: true, class: "space-y-5" do |f| %>
            <div class="grid md:grid-cols-2 md:gap-x-8">
              <fieldset class="space-y-4">
                <legend class="text-lg font-semibold mb-3 text-white border-b border-gray-500 pb-2">Usuário Administrador</legend>
                <div>
                <%= f.label :name, "Nome", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.text_field :name, name: "user[name]", value: @user.name, class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :email, "Email", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.email_field :email, name: "user[email]", value: @user.email, class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :password, "Senha", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.password_field :password, name: "user[password]", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :password_confirmation, "Confirmação da Senha", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.password_field :password_confirmation, name: "user[password_confirmation]", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :avatar, "Avatar", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.file_field :avatar, name: "user[avatar]", class: "block w-full text-sm text-gray-300 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:text-white file:cursor-pointer hover:file:opacity-80", style: "file:background: rgba(255,255,255,0.1); file:border: 1px solid rgba(255,255,255,0.2);" %>
              </div>
              </fieldset>

              <fieldset class="space-y-4">
                <legend class="text-lg font-semibold mb-3 text-white border-b border-gray-500 pb-2">Configuração do Sistema</legend>
                <div>
                <%= f.label :site_name, "Nome do Site", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.text_field :site_name, name: "system_configuration[site_name]", value: @system_config.site_name, class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :site_description, "Descrição do Site", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.text_area :site_description, name: "system_configuration[site_description]", rows: 3, value: @system_config.site_description, class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :contact_email, "Email de Contato", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.email_field :contact_email, name: "system_configuration[contact_email]", value: @system_config.contact_email, class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" %>
              </div>
              <div>
                <%= f.label :logo, "Logo", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.file_field :logo, name: "system_configuration[logo]", class: "block w-full text-sm text-gray-300 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:text-white file:cursor-pointer hover:file:opacity-80", style: "file:background: rgba(255,255,255,0.1); file:border: 1px solid rgba(255,255,255,0.2);" %>
              </div>
              <div>
                <%= f.label :primary_color, "Cor Primária", class: "block text-sm font-medium mb-1 text-gray-200" %>
                <%= f.select :primary_color, options_for_select(SystemConfiguration.color_options, @system_config.primary_color), {}, { name: "system_configuration[primary_color]", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);" } %>
              </div>
              </fieldset>
            </div>

            <div class="pt-5">
              <%= f.submit "Criar Administrador e Configurar", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-white disabled:opacity-50 disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 transition-all shadow-lg", style: "background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%); border-color: var(--color-primary);" %>
            </div>
          <% end %>
        </div>
      </div>
    </main>
  </body>
</html>
