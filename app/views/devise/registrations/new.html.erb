<div class="max-w-md mx-auto w-full">
  <div class="rounded-xl shadow-2xl border" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%); border-color: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
    <div class="p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-center text-white mb-6">Criar nova conta</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :name, "Nome Completo", class: "block text-sm font-medium mb-1 text-gray-200" %>
          <%= f.text_field :name, autocomplete: "name", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "Seu nome" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium mb-1 text-gray-200" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "seu@email.com" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium mb-1 text-gray-200" %>
          <% if @minimum_password_length %>
            <em class="text-xs text-gray-400">(mínimo de <%= @minimum_password_length %> caracteres)</em>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "Crie uma senha" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmação da Senha", class: "block text-sm font-medium mb-1 text-gray-200" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "Repita a senha" %>
        </div>

        <div>
          <%= f.submit "Criar Conta", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-white disabled:opacity-50 disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 transition-all shadow-lg", style: "background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%); border-color: var(--color-primary);" %>
        </div>
      <% end %>

      <div class="text-center mt-6">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
