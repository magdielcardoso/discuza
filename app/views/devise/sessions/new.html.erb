<div class="max-w-md mx-auto w-full">
  <div class="rounded-xl shadow-2xl border" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%); border-color: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
    <div class="p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-center text-white mb-6">Entrar na sua conta</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%# Renderiza mensagens de erro/alerta do Devise %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%- flash.each do |name, msg| -%>
          <% if name == "alert" %>
            <div class="px-4 py-3 rounded-md border" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3); color: #fecaca;" role="alert">
              <p class="text-sm"><%= msg %></p>
            </div>
          <% elsif name == "notice" %>
             <div class="px-4 py-3 rounded-md border" style="background: rgba(var(--color-primary), 0.1); border-color: rgba(var(--color-primary), 0.3); color: var(--color-primary-light);" role="alert">
              <p class="text-sm"><%= msg %></p>
            </div>
          <% end %>
        <%- end -%>

        <div>
          <%= f.label :email, class: "block text-sm font-medium mb-1 text-gray-200" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "seu@email.com" %>
        </div>

        <div>
          <div class="flex justify-between items-center">
             <%= f.label :password, "Senha", class: "block text-sm font-medium mb-1 text-gray-200" %>
             <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-sm font-medium", style: "color: var(--color-primary-light);" %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", class: "py-2 px-3 block w-full rounded-md shadow-sm text-sm text-white disabled:opacity-50 disabled:pointer-events-none", style: "background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); --tw-ring-color: var(--color-primary);", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "shrink-0 mt-0.5 rounded border-gray-500 focus:ring-offset-gray-900", style: "background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); color: var(--color-primary);" %>
            <%= f.label :remember_me, "Lembrar-me", class: "ms-3 text-sm text-gray-300" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Entrar", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-white disabled:opacity-50 disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 transition-all shadow-lg", style: "background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%); border-color: var(--color-primary);" %>
        </div>
      <% end %>

       <%# Links compartilhados do Devise (ajustar o partial separadamente) %>
       <div class="text-center mt-6">
        <%= render "devise/shared/links" %>
       </div>
    </div>
  </div>
</div>
