<!-- ========== FOOTER ========== -->
<footer class="w-full bg-gray-900 border-t border-gray-200 dark:bg-neutral-950 dark:border-neutral-700">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Left side - Made with Discuza -->
      <div class="flex items-center">
        <span class="text-gray-400 text-sm">
          Feito com 
          <span class="font-semibold text-white" style="color: var(--color-primary);">Discuza</span>
        </span>
      </div>

      <!-- Right side - Links -->
      <div class="flex items-center gap-4">
        <%= link_to "https://github.com/magdielcardoso/discuza", target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-white transition-colors duration-200 text-sm flex items-center gap-1" do %>
          <svg class="shrink-0 size-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        <% end %>
        <%= link_to "https://github.com/magdielcardoso/discuza/blob/develop/LICENSE", target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-white transition-colors duration-200 text-sm" do %>
          Licença
        <% end %>
      </div>
    </div>

    <!-- Bottom section -->
    <div class="mt-6 pt-4 border-t border-gray-700 dark:border-neutral-700">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
        <p class="text-gray-400 text-xs">
          © <%= Date.current.year %> <%= SystemConfiguration.instance.site_name %>. Todos os direitos reservados.
        </p>
        <div class="flex items-center gap-4">
          <!-- Social links if needed -->
          <span class="text-gray-400 text-xs">
            Versão 1.0.0
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
<!-- ========== END FOOTER ========== --> 